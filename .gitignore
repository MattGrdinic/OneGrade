# build artifacts
build/
build-cmake/
build-cuda/
*.o
*.ofx
*.ofx.bundle/
.DS_Store

local
__pycache__/

# region-mask experiment: model cache and mask previews
experiments/segmentation/out/
experiments/segmentation/seg-env/

# converted model artefacts: large, regenerable via experiments/segmentation/convert.py,
# and the shipping checkpoint is not settled yet
experiments/segmentation/converted/
experiments/segmentation/verify

# offline bench binary and its outputs
experiments/bench/bench
experiments/looks/looks

# Look-reference corpus. The CURATION is tracked, the pixels are not: films.txt is the editorial
# judgement the targets get fitted to and makes the corpus reproducible, while the stills
# themselves are copyrighted frames kept for local measurement only. See training-data/README.md.
training-data/**
!training-data/
!training-data/README.md
!training-data/looks/
!training-data/looks/*/
!training-data/looks/*/films.txt
# Compiled probes in experiments/ -- these were tracked as Mach-O arm64 binaries, 9 MB of
# build output that only ever worked on one machine.
experiments/segmentation/e2e
experiments/segmentation/wbtest
experiments/segmentation/rawclasses
experiments/segmentation/verify
# Conversion intermediates. Regenerate with convert_paddle.py; see that directory's README.
experiments/segmentation/converted-paddle/*.onnx
experiments/segmentation/converted-paddle/*.pdparams
experiments/segmentation/converted-paddle/*.pnnx.*
experiments/segmentation/converted-paddle/*_pnnx.py
experiments/segmentation/converted-paddle/*.ncnn.*
experiments/segmentation/converted-paddle/*_ncnn.py
experiments/bench/out/
